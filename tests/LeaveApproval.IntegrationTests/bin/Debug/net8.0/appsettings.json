{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/leaveapproval-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 31,
          "fileSizeLimitBytes": 52428800,
          "rollOnFileSizeLimit": true,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "ConnectionStrings": {
    "Default": "Server=localhost;Port=10010;Database=local;User=root;Password=root;charset=utf8mb4"
  },
  "Redis": {
    "ConnectionString": "localhost:6379",
    "InstanceName": ""
  },
  "Jwt": {
    "Issuer": "LeaveApproval.Api",
    "Audience": "LeaveApproval.Client",
    "SecretKey": "DevOnly_LeaveApproval_Jwt_Secret_Key_Change_Me_In_Production_2026",
    "ExpiresInMinutes": 480
  },
  "FileStorage": {
    "RootPath": "uploads"
  },
  "Attachment": {
    "MaxCount": 5,
    "MaxSizeBytes": 10485760,
    "AllowedExtensions": [ ".jpg", ".jpeg", ".png", ".gif", ".pdf", ".doc", ".docx", ".xls", ".xlsx", ".txt", ".zip" ]
  },
  "Leave": {
    "MaxDurationHours": 720
  },
  "Database": {
    "InitializeOnStartup": false
  },
  "Swagger": {
    "Enabled": true
  },
  "AllowedHosts": "*"
}
